{
  "name": "anti-calo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend data (CRUD off-chain), indexer, dan REST API untuk anti-calo.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "indexer": "node --env-file-if-exists=.env src/indexer/run.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "seed:chain": "node scripts/seed-local.mjs chain",
    "seed:details": "node scripts/seed-local.mjs details"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "express": "4.21.2",
    "multer": "2.0.2"
  },
  "devDependencies": {
    "solc": "0.8.28"
  }
}
