+# Backend anti-calo. Salin menjadi .env (tidak di-commit). Jangan isi private key.
+NODE_ENV=development
+PORT=3001
+DB_FILE=./data/anti-calo.db
+UPLOAD_DIR=./data/uploads
+MAX_POSTER_BYTES=2097152
+CORS_ORIGINS=http://localhost:5173
+
+# dev = header x-wallet-address (hanya lokal). signature = tanda tangan wallet per request (wajib di production).
+AUTH_MODE=dev
+AUTH_TTL_SECONDS=300
+
+# Indexer (baca-saja; tidak membutuhkan private key)
+RPC_URL=
+CHAIN_ID=11155111
+TICKET_NFT_ADDRESS=
+MARKETPLACE_ADDRESS=
+START_BLOCK=0
+CONFIRMATIONS=3
+BATCH_SIZE=2000
+POLL_INTERVAL_MS=5000
+REORG_DEPTH=12
