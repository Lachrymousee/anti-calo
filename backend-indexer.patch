+export class HttpError extends Error {
+  constructor(status, message, code = 'error') {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+export const bad = (m, code = 'bad_request') => new HttpError(400, m, code);
+export const unauthorized = (m) => new HttpError(401, m, 'unauthorized');
+export const forbidden = (m) => new HttpError(403, m, 'forbidden');
+export const notFound = (m) => new HttpError(404, m, 'not_found');
+export const conflict = (m) => new HttpError(409, m, 'conflict');
diff --git a/backend/src/api/upload.js b/backend/src/api/upload.js
new file mode 100644
index 0000000..7f35790
--- /dev/null
+++ b/backend/src/api/upload.js
@@ -0,0 +1,36 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import multer from 'multer';
+import { bad } from './errors.js';
+
+// Hanya PNG/JPEG/WebP. SVG sengaja ditolak (dapat memuat script). Tipe ditentukan dari isi file
+// (magic bytes), bukan dari nama atau Content-Type kiriman klien.
+export function sniffImage(buf) {
+  if (buf.length >= 8 && buf.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) return { ext: 'png', mime: 'image/png' };
+  if (buf.length >= 3 && buf[0] === 0xff && buf[1] === 0xd8 && buf[2] === 0xff) return { ext: 'jpg', mime: 'image/jpeg' };
+  if (buf.length >= 12 && buf.toString('ascii', 0, 4) === 'RIFF' && buf.toString('ascii', 8, 12) === 'WEBP') return { ext: 'webp', mime: 'image/webp' };
+  return null;
+}
+
+export function createPosterUpload(config) {
+  const m = multer({ storage: multer.memoryStorage(), limits: { fileSize: config.maxPosterBytes, files: 1, fields: 0 } });
+  return (req, res, next) =>
+    m.single('poster')(req, res, (err) => {
+      if (!err) return next();
+      if (err.code === 'LIMIT_FILE_SIZE') return next(bad(`Ukuran poster maksimal ${Math.floor(config.maxPosterBytes / 1024)} KB.`, 'file_too_large'));
+      return next(bad('Upload tidak valid. Kirim satu file pada field "poster".'));
+    });
+}
+
+// Nama file dibuat server (eventId + potongan hash), bukan dari klien: aman dari path traversal.
+export function savePoster(config, eventId, buf, sha256, ext) {
+  fs.mkdirSync(config.uploadDir, { recursive: true });
+  const file = `${eventId}-${sha256.slice(0, 16)}.${ext}`;
+  fs.writeFileSync(path.join(config.uploadDir, file), buf, { flag: 'w' });
+  return file;
+}
+
+export function removePoster(config, file) {
+  if (!file || file !== path.basename(file)) return;
+  fs.rmSync(path.join(config.uploadDir, file), { force: true });
+}
diff --git a/backend/src/api/validate.js b/backend/src/api/validate.js
new file mode 100644
index 0000000..f2b6a62
--- /dev/null
+++ b/backend/src/api/validate.js
@@ -0,0 +1,45 @@
+import { id as keccakId, toUtf8Bytes, keccak256 } from 'ethers';
+import { bad } from './errors.js';
+
+// Samakan dengan CATEGORIES di src/model.js (tanpa 'Semua').
+export const CATEGORIES = ['Musik', 'Seni & budaya', 'Teknologi', 'Lifestyle'];
+const FIELDS = ['title', 'description', 'category', 'location'];
+const CONTROL = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/;
+
+export function parseId(value, label = 'ID') {
+  if (!/^\d{1,20}$/.test(String(value))) throw bad(`${label} tidak valid.`);
+  return String(BigInt(value));
+}
+
+export function parseDetails(body) {
+  if (!body || typeof body !== 'object' || Array.isArray(body)) throw bad('Body harus berupa objek JSON.');
+  const extra = Object.keys(body).filter((k) => !FIELDS.includes(k));
+  if (extra.length) throw bad(`Field tidak dikenal: ${extra.join(', ')}.`);
+  const out = {};
+  for (const f of FIELDS) {
+    if (typeof body[f] !== 'string') throw bad(`Field ${f} wajib berupa teks.`);
+    out[f] = body[f].trim();
+    if (CONTROL.test(out[f])) throw bad(`Field ${f} memuat karakter yang tidak diizinkan.`);
+  }
+  if (out.title.length < 3 || out.title.length > 120) throw bad('Judul harus 3–120 karakter.');
+  if (out.description.length < 10 || out.description.length > 5000) throw bad('Deskripsi harus 10–5000 karakter.');
+  if (!CATEGORIES.includes(out.category)) throw bad(`Kategori harus salah satu dari: ${CATEGORIES.join(', ')}.`);
+  if (out.location.length < 3 || out.location.length > 200) throw bad('Lokasi harus 3–200 karakter.');
+  return out;
+}
+
+// Hash komitmen yang disimpan organizer di EventParams.detailsHash (on-chain).
+// keccak256(JSON dengan urutan key tetap). Poster diwakili sha256 isi file agar tidak bisa
+// ditukar diam-diam. Jika belum ada poster, posterSha256 = "".
+export function computeDetailsHash(d, posterSha256 = '') {
+  const canonical = JSON.stringify({ v: 1, title: d.title, description: d.description, category: d.category,
+    location: d.location, posterSha256: posterSha256 || '' });
+  return keccak256(toUtf8Bytes(canonical));
+}
+export { keccakId };
+
+export const ZERO_HASH = `0x${'00'.repeat(32)}`;
+export function hashStatus(onchain, computed) {
+  if (!onchain || onchain === ZERO_HASH) return 'unset';
+  return onchain.toLowerCase() === computed.toLowerCase() ? 'match' : 'mismatch';
+}
diff --git a/backend/src/config.js b/backend/src/config.js
new file mode 100644
index 0000000..9b8bc4b
--- /dev/null
+++ b/backend/src/config.js
@@ -0,0 +1,31 @@
+// Konfigurasi dibaca dari environment. Semua nilai bersifat publik kecuali yang tidak ada di sini:
+// backend ini tidak pernah membutuhkan private key.
+const int = (v, d) => (v === undefined || v === '' ? d : Number.parseInt(v, 10));
+
+export function loadConfig(env = process.env) {
+  const nodeEnv = env.NODE_ENV || 'development';
+  const authMode = env.AUTH_MODE || (nodeEnv === 'production' ? 'signature' : 'dev');
+  if (!['dev', 'signature'].includes(authMode)) throw new Error('AUTH_MODE harus dev atau signature.');
+  if (nodeEnv === 'production' && authMode === 'dev') {
+    throw new Error('AUTH_MODE=dev tidak boleh dipakai pada production.');
+  }
+  return {
+    nodeEnv,
+    authMode,
+    authTtlSeconds: int(env.AUTH_TTL_SECONDS, 300),
+    port: int(env.PORT, 3001),
+    dbFile: env.DB_FILE || './data/anti-calo.db',
+    uploadDir: env.UPLOAD_DIR || './data/uploads',
+    maxPosterBytes: int(env.MAX_POSTER_BYTES, 2 * 1024 * 1024),
+    corsOrigins: (env.CORS_ORIGINS || 'http://localhost:5173').split(',').map((s) => s.trim()).filter(Boolean),
+    rpcUrl: env.RPC_URL || '',
+    chainId: int(env.CHAIN_ID, 11155111),
+    ticketAddress: env.TICKET_NFT_ADDRESS || '',
+    marketplaceAddress: env.MARKETPLACE_ADDRESS || '',
+    startBlock: int(env.START_BLOCK, 0),
+    confirmations: int(env.CONFIRMATIONS, 3),
+    batchSize: int(env.BATCH_SIZE, 2000),
+    pollMs: int(env.POLL_INTERVAL_MS, 5000),
+    reorgDepth: int(env.REORG_DEPTH, 12),
+  };
+}
diff --git a/backend/src/db.js b/backend/src/db.js
new file mode 100644
index 0000000..3f3db44
--- /dev/null
+++ b/backend/src/db.js
@@ -0,0 +1,122 @@
+import { DatabaseSync } from 'node:sqlite';
+import fs from 'node:fs';
+import path from 'node:path';
+
+// Tabel chain_events adalah log mentah (sumber kebenaran lokal). Tabel proyeksi lain dapat
+// dibangun ulang dari chain_events kapan saja (lihat rebuild() di indexer/handlers.js).
+// Nilai uint256 disimpan sebagai TEXT (wei) agar tidak kehilangan presisi.
+export const PROJECTION_TABLES = ['roles', 'events', 'gate_checkers', 'tickets', 'purchases', 'listings', 'sales'];
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS sync_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);
+
+CREATE TABLE IF NOT EXISTS chain_events (
+  id TEXT PRIMARY KEY,
+  block_number INTEGER NOT NULL,
+  log_index INTEGER NOT NULL,
+  tx_hash TEXT NOT NULL,
+  block_hash TEXT,
+  contract TEXT NOT NULL,
+  name TEXT NOT NULL,
+  args TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_chain_events_order ON chain_events(block_number, log_index);
+
+CREATE TABLE IF NOT EXISTS roles (
+  role TEXT NOT NULL, account TEXT NOT NULL, active INTEGER NOT NULL,
+  PRIMARY KEY (role, account)
+);
+
+CREATE TABLE IF NOT EXISTS events (
+  event_id TEXT PRIMARY KEY,
+  organizer TEXT NOT NULL,
+  ticket_price TEXT NOT NULL,
+  max_supply INTEGER NOT NULL,
+  max_per_wallet INTEGER NOT NULL,
+  sale_start INTEGER NOT NULL,
+  sale_end INTEGER NOT NULL,
+  event_time INTEGER NOT NULL,
+  resale_cap_bps INTEGER NOT NULL,
+  details_hash TEXT NOT NULL,
+  status TEXT NOT NULL,
+  sold INTEGER NOT NULL DEFAULT 0,
+  checked_in INTEGER NOT NULL DEFAULT 0,
+  created_block INTEGER NOT NULL,
+  updated_block INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_events_organizer ON events(organizer);
+
+CREATE TABLE IF NOT EXISTS gate_checkers (
+  event_id TEXT NOT NULL, checker TEXT NOT NULL, active INTEGER NOT NULL,
+  PRIMARY KEY (event_id, checker)
+);
+
+CREATE TABLE IF NOT EXISTS tickets (
+  token_id TEXT PRIMARY KEY,
+  event_id TEXT NOT NULL,
+  owner TEXT NOT NULL,
+  status TEXT NOT NULL,
+  original_price TEXT NOT NULL,
+  checked_in_by TEXT,
+  checked_in_block INTEGER
+);
+CREATE INDEX IF NOT EXISTS idx_tickets_owner ON tickets(owner);
+CREATE INDEX IF NOT EXISTS idx_tickets_event ON tickets(event_id);
+
+CREATE TABLE IF NOT EXISTS purchases (
+  id TEXT PRIMARY KEY, event_id TEXT NOT NULL, buyer TEXT NOT NULL,
+  first_token_id TEXT NOT NULL, quantity INTEGER NOT NULL, total_paid TEXT NOT NULL, block_number INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_purchases_event ON purchases(event_id);
+
+CREATE TABLE IF NOT EXISTS listings (
+  token_id TEXT PRIMARY KEY, event_id TEXT NOT NULL, seller TEXT NOT NULL,
+  price TEXT NOT NULL, active INTEGER NOT NULL, updated_block INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_listings_event ON listings(event_id);
+
+CREATE TABLE IF NOT EXISTS sales (
+  id TEXT PRIMARY KEY, token_id TEXT NOT NULL, event_id TEXT NOT NULL,
+  buyer TEXT NOT NULL, seller TEXT NOT NULL, price TEXT NOT NULL, fee TEXT NOT NULL, block_number INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_sales_event ON sales(event_id);
+
+-- Data off-chain (CRUD melalui API). Bukan proyeksi blockchain; tidak ikut dihapus saat rebuild.
+CREATE TABLE IF NOT EXISTS event_details (
+  event_id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  description TEXT NOT NULL,
+  category TEXT NOT NULL,
+  location TEXT NOT NULL,
+  poster_file TEXT,
+  poster_sha256 TEXT,
+  created_by TEXT NOT NULL,
+  created_at TEXT NOT NULL,
+  updated_at TEXT NOT NULL,
+  deleted_at TEXT
+);
+`;
+
+export function openDb(file = ':memory:') {
+  if (file !== ':memory:') fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
+  const db = new DatabaseSync(file);
+  db.exec('PRAGMA journal_mode = WAL; PRAGMA busy_timeout = 5000;');
+  db.exec(SCHEMA);
+  return db;
+}
+
+export function tx(db, fn) {
+  db.exec('BEGIN IMMEDIATE');
+  try {
+    const out = fn();
+    db.exec('COMMIT');
+    return out;
+  } catch (err) {
+    db.exec('ROLLBACK');
+    throw err;
+  }
+}
+
+export const getState = (db, key) => db.prepare('SELECT value FROM sync_state WHERE key = ?').get(key)?.value ?? null;
+export const setState = (db, key, value) =>
+  db.prepare('INSERT INTO sync_state (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value').run(key, String(value));
diff --git a/backend/src/indexer/decode.js b/backend/src/indexer/decode.js
new file mode 100644
index 0000000..3f6f0ff
--- /dev/null
+++ b/backend/src/indexer/decode.js
@@ -0,0 +1,34 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { Interface } from 'ethers';
+import { isTracked } from './handlers.js';
+
+const ABI_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../shared/abi');
+
+export function loadInterface(name, abiDir = ABI_DIR) {
+  const json = JSON.parse(fs.readFileSync(path.join(abiDir, `${name}.json`), 'utf8'));
+  return new Interface(json.abi ?? json);
+}
+
+// Mengubah hasil decode ethers menjadi objek biasa: bigint -> string desimal, address -> huruf kecil.
+function plain(param, value) {
+  if (param.baseType === 'tuple') return Object.fromEntries(param.components.map((c, i) => [c.name, plain(c, value[i])]));
+  if (param.baseType === 'array') return Array.from(value, (v) => plain(param.arrayChildren, v));
+  if (typeof value === 'bigint') return value.toString();
+  if (param.type === 'address') return String(value).toLowerCase();
+  if (param.type === 'bytes32') return String(value).toLowerCase();
+  return value;
+}
+
+export function decodeLog(iface, log) {
+  let parsed;
+  try {
+    parsed = iface.parseLog({ topics: [...log.topics], data: log.data });
+  } catch {
+    return null;
+  }
+  if (!parsed || !isTracked(parsed.name)) return null;
+  const args = Object.fromEntries(parsed.fragment.inputs.map((p, i) => [p.name, plain(p, parsed.args[i])]));
+  return { name: parsed.name, args };
+}
diff --git a/backend/src/indexer/handlers.js b/backend/src/indexer/handlers.js
new file mode 100644
index 0000000..2e82322
--- /dev/null
+++ b/backend/src/indexer/handlers.js
@@ -0,0 +1,147 @@
+import { tx, PROJECTION_TABLES } from '../db.js';
+
+export const ADMIN_ROLE = `0x${'00'.repeat(32)}`;
+const ZERO = `0x${'0'.repeat(40)}`;
+const low = (a) => String(a).toLowerCase();
+
+const needEvent = (db, eventId) => {
+  const row = db.prepare('SELECT * FROM events WHERE event_id = ?').get(String(eventId));
+  if (!row) throw new Error(`Event ${eventId} belum terindeks. Periksa START_BLOCK (harus <= blok deployment).`);
+  return row;
+};
+const needTicket = (db, tokenId) => {
+  const row = db.prepare('SELECT * FROM tickets WHERE token_id = ?').get(String(tokenId));
+  if (!row) throw new Error(`Tiket ${tokenId} belum terindeks. Periksa START_BLOCK (harus <= blok deployment).`);
+  return row;
+};
+
+const writeParams = (db, eventId, p, block) =>
+  db.prepare(`UPDATE events SET ticket_price=?, max_supply=?, max_per_wallet=?, sale_start=?, sale_end=?,
+    event_time=?, resale_cap_bps=?, details_hash=?, updated_block=? WHERE event_id=?`)
+    .run(p.ticketPrice, Number(p.maxSupply), Number(p.maxPerWallet), Number(p.saleStart), Number(p.saleEnd),
+      Number(p.eventTime), Number(p.resaleCapBps), low(p.detailsHash), block, eventId);
+
+// Setiap handler menerima (db, args, meta) dan hanya mengubah tabel proyeksi.
+const HANDLERS = {
+  RoleGranted(db, a) {
+    db.prepare(`INSERT INTO roles (role, account, active) VALUES (?, ?, 1)
+      ON CONFLICT(role, account) DO UPDATE SET active = 1`).run(low(a.role), low(a.account));
+  },
+  RoleRevoked(db, a) {
+    db.prepare(`INSERT INTO roles (role, account, active) VALUES (?, ?, 0)
+      ON CONFLICT(role, account) DO UPDATE SET active = 0`).run(low(a.role), low(a.account));
+  },
+  EventCreated(db, a, m) {
+    const p = a.params;
+    db.prepare(`INSERT INTO events (event_id, organizer, ticket_price, max_supply, max_per_wallet, sale_start, sale_end,
+      event_time, resale_cap_bps, details_hash, status, created_block, updated_block)
+      VALUES (?, ?, '0', 0, 0, 0, 0, 0, 0, '', 'active', ?, ?)`).run(String(a.eventId), low(a.organizer), m.blockNumber, m.blockNumber);
+    writeParams(db, String(a.eventId), p, m.blockNumber);
+  },
+  EventUpdated(db, a, m) {
+    needEvent(db, a.eventId);
+    writeParams(db, String(a.eventId), a.params, m.blockNumber);
+  },
+  EventCanceled(db, a, m) {
+    needEvent(db, a.eventId);
+    db.prepare(`UPDATE events SET status='canceled', updated_block=? WHERE event_id=?`).run(m.blockNumber, String(a.eventId));
+  },
+  TicketPurchased(db, a, m, id) {
+    const ev = needEvent(db, a.eventId);
+    const qty = Number(a.quantity);
+    const first = BigInt(a.firstTokenId);
+    const ins = db.prepare(`INSERT INTO tickets (token_id, event_id, owner, status, original_price) VALUES (?, ?, ?, 'valid', ?)`);
+    for (let i = 0n; i < BigInt(qty); i += 1n) ins.run((first + i).toString(), String(a.eventId), low(a.buyer), ev.ticket_price);
+    db.prepare('UPDATE events SET sold = sold + ?, updated_block = ? WHERE event_id = ?').run(qty, m.blockNumber, String(a.eventId));
+    db.prepare(`INSERT INTO purchases (id, event_id, buyer, first_token_id, quantity, total_paid, block_number)
+      VALUES (?, ?, ?, ?, ?, ?, ?)`).run(id, String(a.eventId), low(a.buyer), String(a.firstTokenId), qty, a.totalPaid, m.blockNumber);
+  },
+  TicketCheckedIn(db, a, m) {
+    const t = needTicket(db, a.tokenId);
+    if (t.status === 'used') return; // log ganda tidak boleh menambah penghitung
+    db.prepare(`UPDATE tickets SET status='used', checked_in_by=?, checked_in_block=? WHERE token_id=?`)
+      .run(low(a.checker), m.blockNumber, String(a.tokenId));
+    db.prepare('UPDATE events SET checked_in = checked_in + 1, updated_block = ? WHERE event_id = ?').run(m.blockNumber, String(a.eventId));
+  },
+  TicketRevoked(db, a) {
+    needTicket(db, a.tokenId);
+    db.prepare(`UPDATE tickets SET status='revoked' WHERE token_id=?`).run(String(a.tokenId));
+  },
+  RefundClaimed(db, a) {
+    needTicket(db, a.tokenId);
+    db.prepare(`UPDATE tickets SET status='burned', owner=? WHERE token_id=?`).run(ZERO, String(a.tokenId));
+  },
+  GateCheckerAssigned(db, a) {
+    db.prepare(`INSERT INTO gate_checkers (event_id, checker, active) VALUES (?, ?, 1)
+      ON CONFLICT(event_id, checker) DO UPDATE SET active = 1`).run(String(a.eventId), low(a.checker));
+  },
+  GateCheckerRemoved(db, a) {
+    db.prepare(`INSERT INTO gate_checkers (event_id, checker, active) VALUES (?, ?, 0)
+      ON CONFLICT(event_id, checker) DO UPDATE SET active = 0`).run(String(a.eventId), low(a.checker));
+  },
+  Listed(db, a, m) {
+    needTicket(db, a.tokenId);
+    db.prepare(`INSERT INTO listings (token_id, event_id, seller, price, active, updated_block) VALUES (?, ?, ?, ?, 1, ?)
+      ON CONFLICT(token_id) DO UPDATE SET event_id=excluded.event_id, seller=excluded.seller, price=excluded.price,
+      active=1, updated_block=excluded.updated_block`).run(String(a.tokenId), String(a.eventId), low(a.seller), a.price, m.blockNumber);
+  },
+  ListingCanceled(db, a, m) {
+    db.prepare('UPDATE listings SET active = 0, updated_block = ? WHERE token_id = ?').run(m.blockNumber, String(a.tokenId));
+  },
+  Sold(db, a, m, id) {
+    needTicket(db, a.tokenId);
+    db.prepare('UPDATE listings SET active = 0, updated_block = ? WHERE token_id = ?').run(m.blockNumber, String(a.tokenId));
+    db.prepare('UPDATE tickets SET owner = ? WHERE token_id = ?').run(low(a.buyer), String(a.tokenId));
+    db.prepare(`INSERT INTO sales (id, token_id, event_id, buyer, seller, price, fee, block_number) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`)
+      .run(id, String(a.tokenId), String(a.eventId), low(a.buyer), low(a.seller), a.price, a.fee, m.blockNumber);
+  },
+};
+
+// Dicatat di chain_events untuk jejak audit, tanpa proyeksi.
+const AUDIT_ONLY = new Set(['RevenueWithdrawn', 'ResaleFeeReceived', 'ProceedsWithdrawn']);
+
+export const isTracked = (name) => name in HANDLERS || AUDIT_ONLY.has(name);
+
+function project(db, ev) {
+  const handler = HANDLERS[ev.name];
+  if (handler) handler(db, ev.args, { blockNumber: ev.blockNumber }, ev.id);
+}
+
+// Dipanggil di dalam transaksi pemanggil. Idempoten: log yang sudah ada dilewati.
+export function insertAndProject(db, ev) {
+  const r = db.prepare(`INSERT OR IGNORE INTO chain_events (id, block_number, log_index, tx_hash, block_hash, contract, name, args)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?)`)
+    .run(ev.id, ev.blockNumber, ev.logIndex, ev.txHash, ev.blockHash ?? null, low(ev.contract), ev.name, JSON.stringify(ev.args));
+  if (r.changes === 0) return false;
+  project(db, ev);
+  return true;
+}
+
+export function applyEvents(db, events) {
+  const sorted = [...events].sort((a, b) => a.blockNumber - b.blockNumber || a.logIndex - b.logIndex);
+  return tx(db, () => sorted.reduce((n, e) => n + (insertAndProject(db, e) ? 1 : 0), 0));
+}
+
+const fromRow = (r) => ({ id: r.id, blockNumber: r.block_number, logIndex: r.log_index, txHash: r.tx_hash,
+  blockHash: r.block_hash, contract: r.contract, name: r.name, args: JSON.parse(r.args) });
+
+// Membangun ulang semua tabel proyeksi dari chain_events. Data off-chain tidak disentuh.
+export function rebuild(db) {
+  return tx(db, () => {
+    for (const t of PROJECTION_TABLES) db.exec(`DELETE FROM ${t}`);
+    const rows = db.prepare('SELECT * FROM chain_events ORDER BY block_number, log_index').all();
+    for (const r of rows) project(db, fromRow(r));
+    return rows.length;
+  });
+}
+
+// Menangani reorg: buang log pada blok > blockNumber lalu bangun ulang proyeksi.
+export function rewindTo(db, blockNumber) {
+  return tx(db, () => {
+    const r = db.prepare('DELETE FROM chain_events WHERE block_number > ?').run(blockNumber);
+    for (const t of PROJECTION_TABLES) db.exec(`DELETE FROM ${t}`);
+    const rows = db.prepare('SELECT * FROM chain_events ORDER BY block_number, log_index').all();
+    for (const row of rows) project(db, fromRow(row));
+    return Number(r.changes);
+  });
+}
diff --git a/backend/src/indexer/run.js b/backend/src/indexer/run.js
new file mode 100644
index 0000000..802989b
--- /dev/null
+++ b/backend/src/indexer/run.js
@@ -0,0 +1,60 @@
+import { pathToFileURL } from 'node:url';
+import { JsonRpcProvider, isAddress } from 'ethers';
+import { loadConfig } from '../config.js';
+import { openDb } from '../db.js';
+import { loadInterface } from './decode.js';
+import { syncOnce } from './sync.js';
+
+export function buildInterfaces(config) {
+  for (const [label, addr] of [['TICKET_NFT_ADDRESS', config.ticketAddress], ['MARKETPLACE_ADDRESS', config.marketplaceAddress]]) {
+    if (!isAddress(addr)) throw new Error(`${label} belum diisi atau bukan alamat yang valid.`);
+  }
+  return {
+    [config.ticketAddress.toLowerCase()]: loadInterface('TicketNFT'),
+    [config.marketplaceAddress.toLowerCase()]: loadInterface('Marketplace'),
+  };
+}
+
+// Polling berulang dengan backoff saat RPC gagal. Mengembalikan { stop }.
+export function startIndexer({ db, provider, config, log = console }) {
+  const interfaces = buildInterfaces(config);
+  let stopped = false;
+  let timer;
+  let failures = 0;
+
+  const loop = async () => {
+    if (stopped) return;
+    try {
+      const r = await syncOnce({ db, provider, interfaces, config });
+      failures = 0;
+      if (r.processed || r.rewound) log.info(`[indexer] blok ${r.lastBlock}/${r.head}, ${r.processed} event baru, rewind ${r.rewound}`);
+    } catch (err) {
+      failures += 1;
+      log.error(`[indexer] gagal (percobaan ${failures}): ${err.message}`);
+    }
+    if (!stopped) timer = setTimeout(loop, Math.min(config.pollMs * 2 ** failures, 60_000));
+  };
+
+  (async () => {
+    try {
+      const net = await provider.getNetwork();
+      if (Number(net.chainId) !== config.chainId) {
+        throw new Error(`RPC berjalan di chain ${net.chainId}, sedangkan CHAIN_ID=${config.chainId}.`);
+      }
+      loop();
+    } catch (err) {
+      log.error(`[indexer] tidak dapat dimulai: ${err.message}`);
+    }
+  })();
+
+  return { stop() { stopped = true; clearTimeout(timer); } };
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const config = loadConfig();
+  if (!config.rpcUrl) throw new Error('RPC_URL belum diisi.');
+  const db = openDb(config.dbFile);
+  const provider = new JsonRpcProvider(config.rpcUrl, config.chainId, { staticNetwork: true });
+  const handle = startIndexer({ db, provider, config });
+  for (const sig of ['SIGINT', 'SIGTERM']) process.on(sig, () => { handle.stop(); db.close(); process.exit(0); });
+}
diff --git a/backend/src/indexer/sync.js b/backend/src/indexer/sync.js
new file mode 100644
index 0000000..4e25999
--- /dev/null
+++ b/backend/src/indexer/sync.js
@@ -0,0 +1,57 @@
+import { tx, getState, setState } from '../db.js';
+import { decodeLog } from './decode.js';
+import { insertAndProject, rewindTo } from './handlers.js';
+
+// Satu putaran sinkronisasi: baca log kontrak sampai (head - confirmations), terapkan per batch
+// dalam satu transaksi database bersama checkpoint (blok + hash).
+// interfaces: { [alamatKontrakHurufKecil]: ethers.Interface }
+export async function syncOnce({ db, provider, interfaces, config }) {
+  const addresses = Object.keys(interfaces);
+  const head = await provider.getBlockNumber();
+  const safe = head - config.confirmations;
+  const startFloor = config.startBlock - 1;
+  let last = Number(getState(db, 'last_block') ?? startFloor);
+  let rewound = 0;
+
+  const savedHash = getState(db, 'last_block_hash');
+  if (savedHash && last >= 0) {
+    const current = await provider.getBlock(last);
+    if (!current || current.hash !== savedHash) {
+      // Hash blok checkpoint berubah: chain mengalami reorg. Mundur reorgDepth blok lalu baca ulang.
+      const to = Math.max(startFloor, last - config.reorgDepth);
+      const toBlock = to >= 0 ? await provider.getBlock(to) : null;
+      rewound = rewindTo(db, to);
+      setState(db, 'last_block', to);
+      setState(db, 'last_block_hash', toBlock?.hash ?? '');
+      last = to;
+    }
+  }
+
+  let processed = 0;
+  let from = last + 1;
+  while (from <= safe) {
+    const to = Math.min(from + config.batchSize - 1, safe);
+    const logs = await provider.getLogs({ address: addresses, fromBlock: from, toBlock: to });
+    const events = [];
+    for (const log of logs) {
+      if (log.removed) continue;
+      const iface = interfaces[String(log.address).toLowerCase()];
+      const decoded = iface && decodeLog(iface, log);
+      if (!decoded) continue;
+      events.push({ id: `${log.transactionHash}:${log.index}`, blockNumber: log.blockNumber, logIndex: log.index,
+        txHash: log.transactionHash, blockHash: log.blockHash, contract: log.address, ...decoded });
+    }
+    events.sort((a, b) => a.blockNumber - b.blockNumber || a.logIndex - b.logIndex);
+    const toBlock = await provider.getBlock(to);
+    tx(db, () => {
+      for (const e of events) insertAndProject(db, e);
+      setState(db, 'last_block', to);
+      setState(db, 'last_block_hash', toBlock.hash);
+      setState(db, 'updated_at', new Date().toISOString());
+    });
+    processed += events.length;
+    from = to + 1;
+  }
+  setState(db, 'head_block', head);
+  return { head, safe, lastBlock: Math.max(last, from - 1), processed, rewound };
+}
